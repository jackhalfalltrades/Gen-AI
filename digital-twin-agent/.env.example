# Optional overrides. Put API keys in the repo-root .env, not in a committed file.
#   cp ../.env.example ../.env

# Chat model — used by graph, guards, skills, experience, memory compact
# openai | anthropic | gemini | ollama
LLM_PROVIDER=openai

# Optional. If omitted, a default for that provider is used.
# openai:     gpt-4.1-mini
# anthropic:  claude-sonnet-4-5
# gemini:     gemini-2.0-flash
# ollama:     $OLLAMA_MODEL
LLM_MODEL=gpt-4.1-mini

# Embeddings stay on OpenAI (pgvector index is built with this model)
EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/digital_twin

# Resume chunk size for rag.py ingest
TOKEN_CHUNKS=800
