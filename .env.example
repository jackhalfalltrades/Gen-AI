# Copy to .env in this directory and fill keys there.
#   cp .env.example .env
# .env is gitignored. This file is the one that can be pushed.

# openai | anthropic | gemini | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Leave these blank in git. Put real values only in your local .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Do not set DATABASE_URL here — twin and sentinel use different Postgres.
# Defaults live in each app's config.py / .env.example.
